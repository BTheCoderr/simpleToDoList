{
  "name": "Command Center",
  "short_name": "Command",
  "id": "/",
  "description": "Private local-first signal-first personal productivity command center",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0b1020",
  "theme_color": "#0b1020",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Signal",
      "short_name": "Signal",
      "url": "/?view=today"
    },
    {
      "name": "Quick Add",
      "short_name": "Add",
      "url": "/?quick=1"
    },
    {
      "name": "Focus",
      "short_name": "Focus",
      "url": "/?view=focus"
    },
    {
      "name": "Review",
      "short_name": "Review",
      "url": "/?view=review"
    }
  ],
  "share_target": {
    "action": "/?share=1",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false
}
